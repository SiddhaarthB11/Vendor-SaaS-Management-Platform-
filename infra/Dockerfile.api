FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY api/requirements.txt /app/api/requirements.txt
RUN pip install --no-cache-dir --trusted-host pypi.org --trusted-host pypi.python.org --trusted-host files.pythonhosted.org -r /app/api/requirements.txt

COPY api /app/api
COPY db /app/db
COPY devtools /app/devtools
COPY infra/api-entrypoint.sh /app/infra/api-entrypoint.sh

RUN chmod +x /app/infra/api-entrypoint.sh

ENV PYTHONPATH=/app/api

EXPOSE 8000

ENTRYPOINT ["/app/infra/api-entrypoint.sh"]
